# AXON Configuration
# Copy this file to .env and fill in your values

# ── LLM ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Model to use (default is claude-sonnet-4-6 — best balance of speed and capability)
CLAUDE_MODEL=claude-sonnet-4-6

# ── Audio ─────────────────────────────────────────────────────────────
PUSH_TO_TALK_KEY=ctrl+shift+space
WHISPER_MODEL=base.en
TTS_VOICE=en-US-GuyNeural
TTS_STOP_KEY=escape

# ── Screen ────────────────────────────────────────────────────────────
CAPTURE_MONITOR=1

# ── Execution ─────────────────────────────────────────────────────────
PYTHON_TIMEOUT=30
SHELL_TIMEOUT=30

# ── UI ────────────────────────────────────────────────────────────────
UI_OPACITY=0.95
UI_ACCENT=00d4ff
