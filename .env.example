# AXON Configuration
# Copy this file to .env and fill in your values

# ── Local AI (Ollama — required) ──────────────────────────────────────
# Install Ollama: ollama.com
# Pull models:  ollama pull qwen2.5-coder:14b
#               ollama pull qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_ROUTER_MODEL=qwen2.5:1.5b

# ── Cloud AI (Anthropic — optional) ──────────────────────────────────
# Only needed if you want Claude to handle complex tasks.
# Leave blank to run fully local.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Audio ─────────────────────────────────────────────────────────────
PUSH_TO_TALK_KEY=ctrl+shift+space
WHISPER_MODEL=base.en
TTS_VOICE=en-US-GuyNeural
TTS_STOP_KEY=escape

# ── Screen ────────────────────────────────────────────────────────────
CAPTURE_MONITOR=1

# ── Execution ─────────────────────────────────────────────────────────
PYTHON_TIMEOUT=30
SHELL_TIMEOUT=30

# ── UI ────────────────────────────────────────────────────────────────
UI_OPACITY=0.95
UI_ACCENT=00d4ff
