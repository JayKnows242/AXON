# AXON Configuration
# Copy this file to .env and fill in your values

# ── Claude AI (Anthropic — required) ─────────────────────────────────
# Get your key at: console.anthropic.com
ANTHROPIC_API_KEY=

# Fast model — used for PC control, clicking, simple tasks (cheap & instant)
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001

# Smart model — used for complex code, analysis, reasoning
CLAUDE_SMART_MODEL=claude-sonnet-4-6

# ── Audio ─────────────────────────────────────────────────────────────
PUSH_TO_TALK_KEY=ctrl+shift+space
WHISPER_MODEL=base.en
TTS_VOICE=en-US-GuyNeural
TTS_STOP_KEY=escape

# ── Screen ────────────────────────────────────────────────────────────
CAPTURE_MONITOR=1

# ── Execution ─────────────────────────────────────────────────────────
PYTHON_TIMEOUT=30
SHELL_TIMEOUT=30

# ── UI ────────────────────────────────────────────────────────────────
UI_OPACITY=0.95
UI_ACCENT=00d4ff
